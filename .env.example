# Основное приложение.
# Замените postgres/postgres на пользователя и пароль вашей PostgreSQL.
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/image_service
# Если Redis запущен локально без пароля, это значение можно оставить.
REDIS_DSN=redis://localhost:6379/0
# Замените значение на длинный случайный токен и передавайте его как Bearer.
BEARER_TOKEN=change-me-to-a-long-random-secret-token

# Настоящий интеграционный тест PostgreSQL + Redis.
# База image_service_test должна существовать до запуска теста.
TEST_POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/image_service_test
# Используется отдельная логическая база Redis, чтобы не затронуть основную очередь.
TEST_REDIS_DSN=redis://localhost:6379/15
